<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Section: Browser -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BROWSER"
            android:textSize="11sp"
            android:textColor="@color/colorPrimary"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp" android:paddingBottom="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Enable JavaScript"
                android:textSize="15sp"
                android:textColor="@color/textPrimary" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchJavaScript"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp" android:paddingBottom="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Load Images"
                android:textSize="15sp"
                android:textColor="@color/textPrimary" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchImages"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/dividerColor"
            android:layout_marginVertical="12dp" />

        <!-- Section: Privacy & Security -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PRIVACY &amp; SECURITY"
            android:textSize="11sp"
            android:textColor="@color/colorPrimary"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp" android:paddingBottom="8dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Block Ads"
                    android:textSize="15sp"
                    android:textColor="@color/textPrimary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Block ads and trackers"
                    android:textSize="12sp"
                    android:textColor="@color/textSecondary" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchAdBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/dividerColor"
            android:layout_marginVertical="12dp" />

        <!-- Section: Search Engine -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SEARCH ENGINE"
            android:textSize="11sp"
            android:textColor="@color/colorPrimary"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:paddingBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerSearchEngine"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/spinner_background" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/dividerColor"
            android:layout_marginVertical="12dp" />

        <!-- Section: Data -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DATA"
            android:textSize="11sp"
            android:textColor="@color/colorPrimary"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/btnClearCache"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Clear Cache"
            android:textColor="@color/textPrimary"
            android:background="@drawable/button_outline"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnClearHistory"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Clear History"
            android:textColor="@color/textPrimary"
            android:background="@drawable/button_outline" />

    </LinearLayout>
</ScrollView>
